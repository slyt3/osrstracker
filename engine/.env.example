# Address the engine's HTTP server listens on
ENGINE_ADDR=":8080"

# The OSRS Wiki API requires a DESCRIPTIVE User-Agent (contact info). Generic
# agents get throttled or blocked. Set this to something identifying your app.
WIKI_USER_AGENT="osrstracker - dev - your-contact@example.com"

# How often the poller refreshes the board (Go duration, e.g. 60s, 2m)
POLL_INTERVAL="60s"

# Shared Postgres connection (enables the alert checker when set)
DATABASE_URL="postgresql://osrs:osrs@localhost:5432/osrstracker?schema=public"

# Alert checker (M4)
DISCORD_WEBHOOK_URL=""        # Discord webhook to post alert firings to (empty = log only)
ALERT_INTERVAL="60s"          # how often alerts are evaluated
ALERT_COOLDOWN="30m"          # minimum gap between repeat firings of one alert
